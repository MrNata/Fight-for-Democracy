config_version=5

[application]
config/name="FIGHT FOR DEMOCRACY — DEVELOPER STUDIO"
run/main_scene="res://scenes/studio.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1366
window/size/viewport_height=768
window/size/window_width_override=1366
window/size/window_height_override=768
window/size/min_width=1100
window/size/min_height=650

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.05, 0.09, 1)
